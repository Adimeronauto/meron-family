<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_permissions"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/grantOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_overlay" />

        <Button
            android:id="@+id/grantExactAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_exact_alarm" />

        <Button
            android:id="@+id/grantNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grant_notifications" />

        <Button
            android:id="@+id/appSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_app_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#40808080" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_test"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/fireSnoozeable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/fire_snoozeable" />

        <Button
            android:id="@+id/fireFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fire_final" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#40808080" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_soak"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/soakStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/startSoak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/start_soak" />

        <Button
            android:id="@+id/stopSoak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stop_soak" />

        <Button
            android:id="@+id/clearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clear_log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/recent_fires"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
